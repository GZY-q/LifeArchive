# Run: python3 scripts/init-env.py (creates .env only if absent, mode 0600).
# Never commit .env or copy secrets to a VITE_* frontend variable.
POSTGRES_USER=life_archive
POSTGRES_DB=life_archive
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
WEB_PORT=8080
LIFEARCHIVE_LOG_LEVEL=INFO
# Loopback HTTP development only; use true with HTTPS for a real deployment.
LIFEARCHIVE_COOKIE_SECURE=false
LIFEARCHIVE_TRUSTED_ORIGINS='["http://127.0.0.1:8080","http://127.0.0.1:5173"]'
# Compose stores original images in its private media volume; API never publishes this path.
LIFEARCHIVE_MEDIA_QUOTA_BYTES=1073741824
# Native API development only: set LIFEARCHIVE_MEDIA_ROOT to a private absolute directory.
# Compose uses /var/lib/lifearchive/media inside the container.

# Mainland mirrors; override to the official registry/index when unavailable.
NPM_REGISTRY=https://registry.npmmirror.com
